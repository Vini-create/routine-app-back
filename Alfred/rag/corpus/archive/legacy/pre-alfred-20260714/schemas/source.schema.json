{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Winperium source",
  "type": "object",
  "additionalProperties": true,
  "required": ["source_id", "title", "source_type", "url", "topics", "verification_status", "requires_human_review", "active"],
  "properties": {
    "source_id": {"type": "string", "pattern": "^src-"},
    "title": {"type": "string", "minLength": 3},
    "doi": {"type": "string"},
    "url": {"type": "string", "format": "uri"},
    "verification_status": {"enum": ["verified_primary", "verified_official_repository", "verified_reliable_secondary", "metadata_incomplete", "requires_human_review", "invalid"]},
    "requires_human_review": {"type": "boolean"},
    "active": {"type": "boolean"},
    "topics": {"type": "array", "items": {"type": "string"}}
  }
}
