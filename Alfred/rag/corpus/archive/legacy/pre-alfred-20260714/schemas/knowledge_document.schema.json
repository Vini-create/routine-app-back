{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Winperium knowledge frontmatter",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "title", "document_type", "domain", "agents", "retrieval_terms", "decision_questions", "source_ids", "supported_claims", "status", "requires_human_review", "index_eligible"],
  "properties": {
    "id": {"type": "string", "pattern": "^kd-"},
    "document_type": {"const": "knowledge"},
    "agents": {"type": "array", "items": {"enum": ["alfred", "feedbacker"]}},
    "source_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^src-"}},
    "retrieval_terms": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "decision_questions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 20, "pattern": "\\?$"}
    },
    "supported_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "source_ids", "evidence_strength"]
      }
    },
    "status": {"enum": ["draft", "generated", "research_verified", "machine_audited", "human_reviewed", "deprecated", "quarantined"]},
    "requires_human_review": {"type": "boolean"},
    "index_eligible": {"type": "boolean"}
  }
}
