{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Winperium technique",
  "type": "object",
  "additionalProperties": true,
  "required": ["technique_id", "official_name", "name_pt_br", "technique_origin", "definition", "evidence_level", "source_ids", "status", "requires_human_review", "active"],
  "properties": {
    "technique_id": {"type": "string", "pattern": "^tech-"},
    "technique_origin": {"enum": ["bcttv1", "bcto", "implementation_intentions", "self_determination_theory", "learning_science", "winperium_internal"]},
    "evidence_level": {"enum": ["institutional_guideline", "systematic_review", "meta_analysis", "randomized_trial", "observational_study", "seminal_theory", "canonical_framework", "expert_interpretation", "internal_heuristic"]},
    "status": {"enum": ["draft", "generated", "research_verified", "machine_audited", "human_reviewed", "deprecated", "quarantined"]},
    "requires_human_review": {"type": "boolean"},
    "active": {"type": "boolean"}
  }
}
