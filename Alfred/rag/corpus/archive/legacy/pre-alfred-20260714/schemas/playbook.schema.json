{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Winperium playbook frontmatter",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "title", "document_type", "agents", "use_when", "status", "requires_human_review", "index_eligible"],
  "properties": {
    "id": {"type": "string", "pattern": "^pb-"},
    "document_type": {"const": "playbook"},
    "agents": {"type": "array", "items": {"enum": ["alfred", "feedbacker"]}},
    "use_when": {"type": "array"},
    "status": {"enum": ["draft", "generated", "research_verified", "machine_audited", "human_reviewed", "deprecated", "quarantined"]},
    "requires_human_review": {"type": "boolean"},
    "index_eligible": {"type": "boolean"}
  }
}
