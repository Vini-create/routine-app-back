{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Winperium canonical quote",
  "type": "object",
  "additionalProperties": false,
  "required": ["quote_id", "topic_id", "concept_ids", "original_quote", "original_language", "author", "work", "publication_year", "chapter_or_location", "source_id", "verification_status", "use_when", "avoid_when", "copyright_status", "status"],
  "properties": {
    "quote_id": {"type": "string", "pattern": "^qt-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{3}$"},
    "topic_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "concept_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "original_quote": {"type": "string", "minLength": 3},
    "original_language": {"type": "string", "minLength": 2},
    "author": {"type": "string", "minLength": 2},
    "work": {"type": "string", "minLength": 2},
    "publication_year": {"type": ["integer", "null"]},
    "chapter_or_location": {"type": "string"},
    "source_id": {"type": "string", "pattern": "^src-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "verification_status": {"enum": ["verified_primary_source", "verified_official_edition", "verified_reliable_secondary"]},
    "use_when": {"type": "array", "items": {"type": "string"}},
    "avoid_when": {"type": "array", "items": {"type": "string"}},
    "copyright_status": {"type": "string", "minLength": 3},
    "status": {"enum": ["machine_audited", "human_reviewed"]}
  }
}
