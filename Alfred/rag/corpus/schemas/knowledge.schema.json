{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Winperium canonical knowledge",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "topic_id", "concept_id", "title", "document_type", "language", "source_ids", "supported_claims", "evidence_level", "status", "requires_human_review", "index_in_production", "risk_level", "retrieval_terms", "related_concepts", "version", "last_machine_audited_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^kd-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "topic_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "concept_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 3},
    "document_type": {"const": "knowledge"},
    "language": {"const": "en"},
    "source_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^src-[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "supported_claims": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["claim_id", "source_ids", "evidence_strength"]}},
    "evidence_level": {"type": "string", "minLength": 3},
    "status": {"enum": ["draft", "machine_audited", "human_reviewed", "deprecated", "archived", "quarantined"]},
    "requires_human_review": {"type": "boolean"},
    "index_in_production": {"type": "boolean"},
    "risk_level": {"enum": ["low", "medium", "high"]},
    "retrieval_terms": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "related_concepts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "version": {"type": "string"},
    "last_machine_audited_at": {"type": "string", "format": "date"}
  }
}
