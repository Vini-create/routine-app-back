{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Winperium source record",
  "type": "object",
  "additionalProperties": true,
  "required": ["source_id", "title", "authors", "publication_year", "source_type", "url", "language", "topics", "verification_status", "requires_human_review", "active"],
  "properties": {
    "source_id": {"type": "string", "pattern": "^src-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 3},
    "authors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "publication_year": {"type": "integer"},
    "source_type": {"type": "string", "minLength": 3},
    "doi": {"type": "string"},
    "url": {"type": "string", "format": "uri"},
    "language": {"type": "string", "minLength": 2},
    "topics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "verification_status": {"enum": ["verified_primary", "verified_official_repository", "verified_reliable_secondary", "metadata_incomplete", "requires_human_review", "invalid"]},
    "requires_human_review": {"type": "boolean"},
    "active": {"type": "boolean"},
    "used_in_production_documents": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(kd|pb)-[a-z0-9]+(?:-[a-z0-9]+)*$"}}
  }
}
