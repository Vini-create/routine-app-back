# Application
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/back_routine
SECRET_KEY=replace-this-with-a-random-secret-containing-at-least-64-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SQL_ECHO=false

# Local PostgreSQL (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=back_routine

# Transactional email
BREVO_API_KEY=replace-with-a-brevo-api-key
EMAIL_FROM_NAME=Winperium
EMAIL_FROM_ADDRESS=noreply@example.com

# Authentication
GOOGLE_CLIENT_ID=
LOGIN_CODE_EXPIRE_MINUTES=10
LOGIN_CODE_MAX_ATTEMPTS=5

# Rate limiting
# Required in production, for example: redis://default:password@redis:6379
RATE_LIMIT_STORAGE_URI=

# Routine query and scheduling boundaries
LOG_BACKFILL_LIMIT_DAYS=30
ROUTINE_AGENDA_MAX_RANGE_DAYS=90
HABITS_DASHBOARD_MAX_RANGE_DAYS=90
GOALS_DASHBOARD_MAX_RANGE_DAYS=365
FUTURE_SCHEDULE_LIMIT_YEARS=5

# AI providers and model roles
OPENAI_API_KEY=replace-with-an-openai-api-key
AI_ROUTER_MODEL=gpt-4o-mini
AI_ALFRED_MODEL=gpt-4o-mini
AI_FEEDBACKER_MODEL=gpt-5
AI_CRITIC_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# AI runtime boundaries
AI_RAG_CANDIDATE_LIMIT=12
AI_RAG_EVIDENCE_LIMIT=4
AI_MODEL_TIMEOUT_SECONDS=45
AI_MODEL_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_SECONDS=110
AI_RESERVATION_TIMEOUT_SECONDS=120
AI_GLOBAL_DAILY_COST_LIMIT_USD=10.00

# AI data retention
AI_MESSAGE_RETENTION_DAYS=90
AI_PATCH_RETENTION_DAYS=90
AI_EXPIRED_PATCH_GRACE_DAYS=7
AI_DELETED_CONVERSATION_RETENTION_DAYS=30
AI_INTERVENTION_RETENTION_DAYS=180
AI_OBSERVABILITY_RETENTION_DAYS=400
