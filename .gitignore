# Environment
.env
.env.*
!.env.example
.direnv/

# Secrets and credentials
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
credentials/
secrets/

# Dependencies and virtual environments
.venv/
venv/
ENV/

# Python build and packaging
__pycache__/
*.py[cod]
build/
dist/
wheels/
*.egg-info/

# Alfred's audited RAG build is required at runtime. Keep the global build
# ignore while allowing only the validated production artifacts.
!Alfred/rag/corpus/build/
Alfred/rag/corpus/build/*
!Alfred/rag/corpus/build/chunks.jsonl
!Alfred/rag/corpus/build/manifest.json
!Alfred/rag/corpus/build/faiss/
Alfred/rag/corpus/build/faiss/*
!Alfred/rag/corpus/build/faiss/knowledge.faiss
!Alfred/rag/corpus/build/faiss/knowledge.metadata.jsonl
!Alfred/rag/corpus/build/faiss/playbooks.faiss
!Alfred/rag/corpus/build/faiss/playbooks.metadata.jsonl
!Alfred/rag/corpus/build/faiss/manifest.json

